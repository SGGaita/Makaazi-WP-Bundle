# This repository lives in wp-content/. Only the Makaazi theme and plugins are tracked.
/*
!/.gitignore
!/README.md
!/docs/
!/tests/
!/.github/
!/composer.json
!/package.json
!/phpunit.xml.dist
!/.phpcs.xml.dist
!/.wp-env.json
!/themes/
/themes/*
!/themes/makaazi-theme/
!/plugins/
/plugins/*
!/plugins/makaazi-core/
!/plugins/makaazi-hero-slider/
.DS_Store
Thumbs.db

# Tooling output
/vendor/
/node_modules/
/dist/
tests/e2e/node_modules
tests/e2e/test-results/
tests/e2e/playwright-report/
test-results/
