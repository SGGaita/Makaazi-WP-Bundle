{
	"name": "ascension-dynamics/makaazi",
	"description": "Makaazi property listing template for WordPress: block theme, Makaazi Core and Makaazi Hero Slider.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Ascension Dynamics",
			"homepage": "https://ascensiondynamics.co/"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs -n",
		"lint:fix": "phpcbf -n",
		"test": "phpunit"
	}
}
